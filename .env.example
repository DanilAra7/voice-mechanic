# Copy to .env and fill in. .env is gitignored and never leaves this machine.
#   cp .env.example .env

# --- Vast.ai (rented GPU) -------------------------------------------------
# console.vast.ai -> Keys -> API Keys -> Copy. Used by scripts/idle_shutdown.py
# and by the vast CLI to create/stop instances so an idle GPU stops billing.
VAST_API_KEY=

# Instance id of the current rental (Vast sets CONTAINER_ID inside the
# instance; set it by hand when running the watcher from the laptop).
VAST_INSTANCE_ID=

# --- Backend --------------------------------------------------------------
# Where the Torque simulator posts its uploads (the backend's own address).
MECHANIC_SELF_URL=http://127.0.0.1:8000
MECHANIC_DB=data/cache/torque.sqlite

# --- Model servers (filled in on day 3, after the benchmark) --------------
# OpenAI-compatible endpoint of the local LLM server (vLLM or llama.cpp).
MECHANIC_LLM_BASE_URL=http://127.0.0.1:8001/v1
MECHANIC_LLM_MODEL=
